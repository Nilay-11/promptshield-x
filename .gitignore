# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Env / secrets
.env

# Data / logs (contains audit data, don't commit)
data/logs/*.db
data/logs/*.json
data/datasets/*

# HuggingFace / model cache
.cache/
*.bin
*.safetensors

# OS
.DS_Store

# IDE
.vscode/
.idea/

# fine-tuned model weights pulled from Colab (large binary files)
app/modules/weights/*
!app/modules/weights/.gitkeep
# production models are committed through Git LFS (see .gitattributes); old/backup models stay local
!app/modules/weights/distilbert/
!app/modules/weights/distilbert_prompt/
!app/modules/weights/type_classifier/
!app/modules/weights/risk_calibrator.json
!app/modules/weights/manifest.json
!app/modules/weights/isolation_forest.pkl
!app/modules/weights/**/*.safetensors

